  "narrative": {
    "northStar": "Laboratorio comparativo",
    "overview": "Laboratorio comparativo organiza el análisis como una hoja de trabajo clara, minimalista y sobria. El marco frío y la hoja blanca sostienen la información; la jerarquía depende de tipografía, alineación y espacio. El color identifica datos y estados.\n\nLos controles son discretos y familiares. La evidencia conserva el modelo, las métricas, la unidad y el alcance junto a la lectura; los estados desconocidos se expresan con texto. La precisión visual acompaña la precisión de las cifras.",
    "keyCharacteristics": [
      "Hoja enmarcada sobre fondo frío.",
      "Tipografía Plex local y cifras tabulares.",
      "Paneles planos con bordes suaves.",
      "Color funcional para series, selección y estados."
    ],
    "rules": [
      {
        "name": "The Color With Evidence Rule",
        "body": "Todo estado debe llevar texto o etiqueta además del color.",
        "section": "colors"
      },
      {
        "name": "The Stable Numbers Rule",
        "body": "Las cifras conservan alineación tabular y se actualizan sin contadores animados.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Los paneles se distinguen por borde, espacio y tono; no por elevación decorativa.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do conservar modelo, unidad y alcance junto a las métricas.",
      "Do acompañar el color de estados con texto y etiquetas.",
      "Do mantener las cifras tabulares y las tablas desplazables dentro de su contenedor.",
      "Do respetar el foco visible, los controles nativos y movimiento reducido."
    ],
    "donts": [
      "Don't añadir sombras a los paneles ni animación de cifras.",
      "Don't representar un dato ausente como cero o como normalidad.",
      "Don't ocultar columnas para aparentar que una tabla cabe.",
      "Don't dar por verificada la composición sin inspección del render."
    ]
  }
}
